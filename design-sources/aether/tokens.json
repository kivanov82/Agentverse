{
  "$schema": "Aether design tokens — contract for the Claude Design canvas and the built storefront. Dark, electric, glass.",
  "meta": {
    "brand": "Aether",
    "tagline": "Your home, aware.",
    "direction": "futuristic / electric — near-black canvas, electric-teal accent, glass panels, subtle grid",
    "theme": "dark (primary; no light theme at launch)"
  },
  "colors": {
    "ink": "#0B0F12",
    "inkDeep": "#070A0C",
    "surface": "#11181D",
    "surfaceRaised": "#161F25",
    "surfaceOverlay": "rgba(18, 27, 33, 0.72)",
    "border": "#1E2A30",
    "borderStrong": "#2A3A42",
    "borderAccent": "rgba(21, 194, 165, 0.45)",
    "text": "#E8F1EE",
    "textMuted": "#88A0A6",
    "textFaint": "#5A6E74",
    "accent": "#15C2A5",
    "accentHover": "#23D8B9",
    "accentPressed": "#0FA68C",
    "accentSoft": "rgba(21, 194, 165, 0.14)",
    "accentInk": "#04130F",
    "success": "#3DD68C",
    "warning": "#F5B43D",
    "error": "#FF6B81",
    "info": "#5AB0FF",
    "focusRing": "rgba(35, 216, 185, 0.55)"
  },
  "gradients": {
    "heroGlow": "radial-gradient(120% 120% at 70% 0%, rgba(21,194,165,0.22) 0%, rgba(21,194,165,0.06) 35%, rgba(11,15,18,0) 70%)",
    "panelSheen": "linear-gradient(135deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0) 45%)",
    "accentLine": "linear-gradient(90deg, rgba(21,194,165,0) 0%, #15C2A5 50%, rgba(21,194,165,0) 100%)",
    "gridFade": "linear-gradient(180deg, rgba(11,15,18,0) 0%, #0B0F12 90%)"
  },
  "typography": {
    "fontFamily": {
      "display": "'Space Grotesk', system-ui, sans-serif",
      "body": "'Space Grotesk', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', monospace"
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontSizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "1.75rem",
      "3xl": "2.25rem",
      "4xl": "3rem",
      "5xl": "4rem",
      "6xl": "5.25rem"
    },
    "lineHeights": {
      "tight": 1.05,
      "snug": 1.2,
      "normal": 1.5,
      "relaxed": 1.7
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.04em",
      "label": "0.12em"
    },
    "roles": {
      "hero": { "family": "display", "size": "6xl", "weight": "bold", "lineHeight": "tight", "letterSpacing": "tight" },
      "h1": { "family": "display", "size": "4xl", "weight": "bold", "lineHeight": "snug", "letterSpacing": "tight" },
      "h2": { "family": "display", "size": "2xl", "weight": "semibold", "lineHeight": "snug" },
      "h3": { "family": "display", "size": "xl", "weight": "semibold", "lineHeight": "snug" },
      "body": { "family": "body", "size": "base", "weight": "regular", "lineHeight": "relaxed" },
      "small": { "family": "body", "size": "sm", "weight": "regular", "lineHeight": "normal" },
      "eyebrow": { "family": "mono", "size": "xs", "weight": "medium", "letterSpacing": "label", "transform": "uppercase" },
      "price": { "family": "mono", "size": "xl", "weight": "medium", "letterSpacing": "tight" },
      "spec": { "family": "mono", "size": "sm", "weight": "regular", "lineHeight": "normal" }
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "32": "8rem"
  },
  "borderRadius": {
    "none": "0",
    "sm": "0.375rem",
    "md": "0.625rem",
    "lg": "1rem",
    "xl": "1.5rem",
    "full": "9999px"
  },
  "borderWidth": {
    "hairline": "1px",
    "thick": "2px"
  },
  "glass": {
    "panel": {
      "background": "rgba(18, 27, 33, 0.55)",
      "border": "1px solid rgba(255, 255, 255, 0.06)",
      "backdropFilter": "blur(18px) saturate(140%)"
    },
    "card": {
      "background": "rgba(22, 31, 37, 0.6)",
      "border": "1px solid #1E2A30",
      "backdropFilter": "blur(10px)"
    }
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.4)",
    "md": "0 8px 24px rgba(0, 0, 0, 0.45)",
    "lg": "0 24px 60px rgba(0, 0, 0, 0.55)",
    "glow": "0 0 0 1px rgba(21,194,165,0.35), 0 0 32px rgba(21,194,165,0.25)",
    "glowSoft": "0 0 24px rgba(21,194,165,0.18)"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "220ms", "slow": "420ms", "reveal": "640ms" },
    "easing": {
      "standard": "cubic-bezier(0.22, 1, 0.36, 1)",
      "entrance": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reveal": { "translateY": "16px", "stagger": "70ms" }
  },
  "grid": {
    "lineColor": "rgba(232, 241, 238, 0.04)",
    "cellSize": "64px"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "layout": {
    "maxWidth": "1200px",
    "gutter": "1.5rem",
    "tapTargetMin": "44px"
  }
}
