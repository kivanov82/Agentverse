# ShipWithAI Environment Configuration
#
# Local dev: copy to .env / apps/web/.env.local and fill in.
# Production: values live in GCP Secret Manager + Cloud Run env vars (see scripts/deploy.sh).

# ─── Claude ─────────────────────────────────────────────
# Required. Used by every agent invocation.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Free mode (local dev only) ─────────────────────────
# Bypasses auth + credit gate so you can run agents without signing in.
# Production: both flags must be 'false' (see scripts/deploy.sh).
SHIPWITHAI_FREE_MODE=true
NEXT_PUBLIC_SHIPWITHAI_FREE_MODE=true

# ─── Firebase / Firestore ───────────────────────────────
# Project the Firestore database lives in.
FIREBASE_PROJECT_ID=bright-union
# Local dev only: path to a Firestore service-account JSON.
# On Cloud Run this is ignored — the attached service account is used.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ─── GitHub (required) ──────────────────────────────────
# GitHub App is used for repo reads.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Personal Access Token is used for repo writes (App tokens unreliable on personal accounts).
GITHUB_PAT=
# Org/user where project repos are created.
GITHUB_REPO_OWNER=

# ─── NextAuth (Phase 2: auth + credits) ─────────────────
# JWT signing secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Canonical URL — https://shipwithai.nl in production, auto-inferred in dev.
NEXTAUTH_URL=http://localhost:3000
# Google OAuth (optional — SIWE works without it).
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Payments (Phase 3: credit top-ups) ─────────────────
# Stripe Checkout for card top-ups.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: custom Base mainnet RPC for x402 USDC top-up verification.
# Falls back to https://mainnet.base.org when unset.
BASE_RPC_URL=

# ─── Optional integrations ──────────────────────────────
# Enables wallet connect (RainbowKit). Without it, SIWE is unavailable.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Enables web_search tool.
BRAVE_SEARCH_API_KEY=
# Enables sandbox command execution.
E2B_API_KEY=
# Enables deployer agent's Vercel tools.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
