# Dependencies / build output
node_modules/
dist/
out/
.next/
*.tsbuildinfo

# Client engagement working dirs — client work stays out of git; only the index is tracked
engagements/*
!engagements/index.json

# Local tooling — track shared project settings, ignore personal + local state
.claude/*
!.claude/settings.json
.playwright-mcp/

# Secrets / environment
.env
.env.local
.env.*.local
*-sa-key.json
*-service-account*.json

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
*.swp
*.swo

# Logs / temp
*.log
tmp/
.cache/

# Keep
!.gitkeep
